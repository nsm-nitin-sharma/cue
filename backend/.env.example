# ==========================================
# Cue Backend Environment Template
# ==========================================

APP_ENV=development
APP_NAME=Cue Voice-First Business OS
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000

# Supabase (Free Tier)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-or-secret-key

# AI & Speech Providers (Free Tier Split)
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-google-ai-studio-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash-lite

STT_PROVIDER=groq_whisper
GROQ_API_KEY=your-groq-free-tier-api-key
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# Optional Local Adapters (Disabled by default to protect PC performance)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
FASTER_WHISPER_MODEL_SIZE=base

# Security & Business Policy Guardrails
HIGH_VALUE_CONFIRM_THRESHOLD_INR=5000
MAX_AUDIO_UPLOAD_MB=10
RATE_LIMIT_REQUESTS_PER_MINUTE=60
CONVERSATION_MEMORY_DAYS=30
DEFAULT_TIMEZONE=Asia/Kolkata
CONFIRMATION_TOKEN_TTL_SECONDS=300
