# Environment & Secret Files (NEVER commit)
.env
.env.*
!.env.example
!.env.local.example
*.env
*.pem
*.key
*.crt
*.p12
*.pfx
*service-account*.json
*credentials*.json
secrets/

# Python / Backend
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
build/
